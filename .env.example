# BASE SERVICE
# Port mapping for base service
BASE_PORT=3001
# PostgreSQL connection string
BASE_DATABASE_URL=postgresql://dkoldaev@host.docker.internal:5432/english_card_bot?schema=public
# JWT Secret for authentication
BASE_JWT_SECRET=supersecret_docker_key
# Internal Mercure URL for pushing events
BASE_MERCURE_URL=http://mercure/.well-known/mercure
# JWT Secret for Mercure authentication
BASE_MERCURE_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJtZXJjdXJlIjp7InB1Ymxpc2giOlsiKiJdfSwiaWF0IjoxNzg3Njk0ODEyfQ.tmkgmm48l6GAnxBkxG4bz-KfjjwNdPV-t5DROZmsa9s
# Internal URL of Translator service
BASE_TRANSLATOR_API_URL=http://translator:3001/api/v1/translate
# Internal URL of Definer service
BASE_DEFINER_API_URL=http://definer:3002/api/v1/define
# Definer app type to use (mock, mistral, gemini, freedictionary)
BASE_DEFINER_APP_TYPE=freedictionary
# Translator app type to use (mock, googletranslate, laratranslate)
BASE_TRANSLATOR_APP_TYPE=laratranslate
# Base domain of the application
BASE_DOMAIN=http://localhost
# Redis connection URL
BASE_REDIS_URL=redis://redis:6379
# Allowed CORS origin (usually frontend)
BASE_CORS_ORIGIN=http://localhost:5174

# MERCURE SERVICE
# Server name/port for mercure
MERCURE_SERVER_NAME=:80
# Secret for both publisher and subscriber
MERCURE_JWT_KEY=supersecret_mercure_key
# Allowed CORS for mercure
MERCURE_CORS_ALLOWED_ORIGINS=*
# Allow anonymous subscriptions
MERCURE_ALLOW_ANONYMOUS=1

# TRANSLATOR SERVICE
# Port mapping for translator service
TRANSLATOR_PORT=3001
# API Key for Google Translate (optional)
TRANSLATOR_GOOGLE_TRANSLATE_API_KEY=
# Mock timeout for translator service (ms, 0 for no delay)
TRANSLATOR_MOCK_TIMEOUT=0
# Lara Translate API credentials
TRANSLATOR_LARA_ACCESS_KEY_ID=
TRANSLATOR_LARA_ACCESS_KEY_SECRET=
# Redis URL specifically for the translator service cache (defaults to BASE_REDIS_URL/1)
TRANSLATOR_CACHE_URL=redis://redis:6379/1

# DEFINER SERVICE
# Port mapping for definer service
DEFINER_PORT=3002
# API Key for Mistral AI (optional)
DEFINER_MISTRAL_API_KEY=
# API Key for Gemini AI (optional)
DEFINER_GEMINI_API_KEY=
# Mock timeout for definer service (ms, 0 for no delay)
DEFINER_MOCK_TIMEOUT=0
# Redis URL specifically for the definer service cache (defaults to BASE_REDIS_URL/2)
DEFINER_CACHE_URL=redis://redis:6379/2

# FRONTEND SERVICE
# Public API URL for frontend to connect to base service
FRONTEND_VITE_API_BASE_URL=http://localhost:3001/api/v1
# Public Mercure URL for frontend to connect to events
FRONTEND_VITE_MERCURE_PUBLIC_URL=http://localhost:9090/.well-known/mercure
# Base domain used in frontend
FRONTEND_VITE_BASE_DOMAIN=http://localhost
