# BASE SERVICE
# Target environment for the base image build (development/production)
BASE_TARGET=development
# Port mapping for base service
BASE_PORT=3001
# PostgreSQL connection string
BASE_DATABASE_URL=postgresql://dkoldaev@host.docker.internal:5432/english_card_bot?schema=public
# JWT Secret for authentication
BASE_JWT_SECRET=supersecret_docker_key
# Internal Mercure URL for pushing events
BASE_MERCURE_URL=http://mercure/.well-known/mercure
# JWT Secret for Mercure authentication
BASE_MERCURE_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJtZXJjdXJlIjp7InB1Ymxpc2giOlsiKiJdfSwiaWF0IjoxNzg3Njk0ODEyfQ.tmkgmm48l6GAnxBkxG4bz-KfjjwNdPV-t5DROZmsa9s
# Internal URL of Translator service
BASE_TRANSLATOR_API_URL=http://translator:3001/api/v1/translate
# Internal URL of Definer service
BASE_DEFINER_API_URL=http://definer:3002/api/v1/define
# Definer app type to use (mock, mistral, gemini, freedictionary)
BASE_DEFINER_APP_TYPE=freedictionary
# Translator app type to use (mock, googletranslate, laratranslate, llm, mistral, gemini)
BASE_TRANSLATOR_APP_TYPE=laratranslate
# Base domain of the application
BASE_DOMAIN=http://localhost
# Redis connection URL
BASE_REDIS_URL=redis://redis:6379
# Allowed CORS origin (usually frontend)
BASE_CORS_ORIGIN=http://localhost:5174
# Enable test username auth (/api/v1/auth/register and /api/v1/auth/login)
BASE_ENABLE_TEST_AUTH=false
# Internal URL of LLM service
BASE_LLM_API_URL=http://llm:3003/api/v1/generate
# LLM provider to use (mock, mistral, gemini)
BASE_LLM_PROVIDER=mock
# LLM model to use
BASE_LLM_MODEL=mock
# Enable database query logging in Base service (true/false)
BASE_ENABLE_DB_LOGGING=false
# Guest mode AI generation setting (true/false) and daily limit per IP
BASE_ALLOW_GUEST_AI_GENERATION=false
BASE_GUEST_AI_DAILY_LIMIT=10

# MERCURE SERVICE
# Port mapping for mercure service
MERCURE_PORT=9090
# Server name/port for mercure
MERCURE_SERVER_NAME=:80
# Secret for both publisher and subscriber
MERCURE_JWT_KEY=supersecret_mercure_key
# Allowed CORS for mercure
MERCURE_CORS_ALLOWED_ORIGINS=*
# Allow anonymous subscriptions
MERCURE_ALLOW_ANONYMOUS=1

# TRANSLATOR SERVICE
# Target environment for the translator image build (development/production)
TRANSLATOR_TARGET=development
# Port mapping for translator service
TRANSLATOR_PORT=3001
# API Key for Google Translate (optional)
TRANSLATOR_GOOGLE_TRANSLATE_API_KEY=
# Mock timeout for translator service (ms, 0 for no delay)
TRANSLATOR_MOCK_TIMEOUT=0
# Lara Translate API credentials
TRANSLATOR_LARA_ACCESS_KEY_ID=
TRANSLATOR_LARA_ACCESS_KEY_SECRET=
# Redis URL specifically for the translator service cache (defaults to BASE_REDIS_URL/1)
TRANSLATOR_CACHE_URL=redis://redis:6379/1
# URL of the LLM service
TRANSLATOR_LLM_SERVICE_URL=http://llm:3003/api/v1/generate
# LLM Provider for translator if using "llm" type (mock, mistral, gemini)
TRANSLATOR_LLM_PROVIDER=mistral
# LLM Model for translator
TRANSLATOR_LLM_MODEL=open-mistral-nemo

# LLM SERVICE
# Target environment for the llm image build (development/production)
LLM_TARGET=development
# Port mapping for llm service
LLM_PORT=3003
# API Key for Mistral AI (optional)
LLM_MISTRAL_API_KEY=
# API Key for Gemini AI (optional)
LLM_GEMINI_API_KEY=
# Mock timeout for llm service (ms, 0 for no delay)
LLM_MOCK_TIMEOUT=0
# Redis URL specifically for the llm service cache (defaults to BASE_REDIS_URL/3)
LLM_CACHE_URL=redis://redis:6379/3

# DEFINER SERVICE
# Target environment for the definer image build (development/production)
DEFINER_TARGET=development
# Port mapping for definer service
DEFINER_PORT=3002
# URL of the LLM service
DEFINER_LLM_SERVICE_URL=http://llm:3003/api/v1/generate
# LLM Provider for definer (mistral, gemini, mock)
DEFINER_LLM_PROVIDER=mistral
# LLM Model for definer
DEFINER_LLM_MODEL=open-mistral-nemo
# Mock timeout for definer service (ms, 0 for no delay)
DEFINER_MOCK_TIMEOUT=0
# Redis URL specifically for the definer service cache (defaults to BASE_REDIS_URL/2)
DEFINER_CACHE_URL=redis://redis:6379/2

# FRONTEND SERVICE
# Target environment for the frontend image build (development/production)
FRONTEND_TARGET=development
# Public API URL for frontend to connect to base service
FRONTEND_API_BASE_URL=http://localhost:5174/api/v1
# Public Mercure URL for frontend to connect to events
FRONTEND_MERCURE_PUBLIC_URL=http://localhost:5174/.well-known/mercure
# Base domain used in frontend
FRONTEND_BASE_DOMAIN=http://localhost
# Allowed hosts for vite preview (comma separated)
FRONTEND_ALLOWED_HOSTS=localhost:5174,127.0.0.1:5174,localhost:5173,127.0.0.1:5173
# Auth provider to use in frontend: google | test-username
FRONTEND_AUTH_PROVIDER=google

# AUTH
# Google OAuth Client ID for both backend verification and frontend login button
GOOGLE_CLIENT_ID=your_google_client_id_here
