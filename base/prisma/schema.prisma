generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserMode {
  DEFAULT
  ADDING_WORDS
  EDITING_DICTIONARY
  DICTIONARY_VIEW
  DICTIONARY_ADD
  QUIZ
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  picture   String?
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now())

  accounts     Account[]
  state        UserState?
  dictionaries Dictionary[]
}

model Account {
  id                Int    @id @default(autoincrement())
  userId            Int
  provider          String
  providerAccountId String
  
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
}

model Dictionary {
  id             Int      @id @default(autoincrement())
  name           String
  targetLanguage String
  baseLanguage   String
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  words      Word[]
  userStates UserState[]

  @@index([userId])
}

model UserState {
  id   Int      @id @default(autoincrement())

  /// @deprecated
  mode UserMode @default(DEFAULT) @ignore

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeDictionaryId Int?
  activeDictionary   Dictionary? @relation(fields: [activeDictionaryId], references: [id], onDelete: SetNull)

  currentWordId Int?
  currentWord   Word? @relation(fields: [currentWordId], references: [id], onDelete: SetNull)

  showVariants              Boolean @default(false)
  showDefinitionTranslation Boolean @default(false)

  currentDefinitionId Int?
  currentDefinition   Definition? @relation(fields: [currentDefinitionId], references: [id], onDelete: SetNull)
}

model Word {
  id           Int        @id @default(autoincrement())
  text         String
  dictionaryId Int
  dictionary   Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  definitions Definition[]
  userStates  UserState[]
  presets     Preset[]

  @@unique([dictionaryId, text])
}

model Definition {
  id        Int      @id @default(autoincrement())
  text      String
  wordId    Int
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  translation DefinitionTranslation?
  userStates  UserState[]
  presets     Preset[]
}

model DefinitionTranslation {
  id           Int        @id @default(autoincrement())
  text         String
  definitionId Int        @unique
  definition   Definition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

model Preset {
  id          Int      @id @default(autoincrement())
  title       String
  forLanguage String   @map("for_language")
  body        Json
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  words       Word[]
  definitions Definition[]

  @@index([forLanguage])
}

