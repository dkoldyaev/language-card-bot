generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserMode {
  DEFAULT
  ADDING_WORDS
  EDITING_DICTIONARY
  DICTIONARY_VIEW
  DICTIONARY_ADD
  QUIZ
}


model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  picture   String?
  createdAt DateTime @default(now())

  accounts Account[]
  state    UserState?
  settings UserSettings?
  words    Word[]
}

model Account {
  id                Int    @id @default(autoincrement())
  userId            Int
  provider          String
  providerAccountId String
  
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
}

model UserState {
  id   Int      @id @default(autoincrement())

  /// @deprecated
  mode UserMode @default(DEFAULT) @ignore

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentWordId Int?
  currentWord   Word? @relation(fields: [currentWordId], references: [id], onDelete: SetNull)

  showVariants              Boolean @default(false)
  showDefinitionTranslation Boolean @default(false)

  currentDefinitionId Int?
  currentDefinition   Definition? @relation(fields: [currentDefinitionId], references: [id], onDelete: SetNull)
}

model UserSettings {
  id             Int    @id @default(autoincrement())
  baseLanguage   String
  targetLanguage String
  desiredLevel   String

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Word {
  id        Int      @id @default(autoincrement())
  text      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  definitions Definition[]
  userStates  UserState[]

  @@unique([userId, text])
}

model Definition {
  id        Int      @id @default(autoincrement())
  text      String
  wordId    Int
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  translation DefinitionTranslation?
  userStates  UserState[]
}

model DefinitionTranslation {
  id           Int        @id @default(autoincrement())
  text         String
  definitionId Int        @unique
  definition   Definition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}
