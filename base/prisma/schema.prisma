generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserMode {
  DEFAULT
  ADDING_WORDS
  EDITING_DICTIONARY
  DICTIONARY_VIEW
  DICTIONARY_ADD
  TRAINING
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  createdAt    DateTime   @default(now())
  
  state        UserState?
  settings     UserSettings?
}

model UserState {
  id     Int      @id @default(autoincrement())
  mode   UserMode @default(DEFAULT)

  userId Int      @unique
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id             Int      @id @default(autoincrement())
  baseLanguage   String
  targetLanguage String
  desiredLevel   String

  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
