{
  "name": "english-card-bot-2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "admin:create": "node run-script.js admin-create",
    "build": "tsc",
    "db:profile": "node run-script.js profile-queries",
    "dev": "tsx watch src/index.ts",
    "preset:create": "node run-script.js preset-create",
    "preset:list": "node run-script.js preset-list",
    "preset:remove": "node run-script.js preset-remove",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "start": "node dist/index.js",
    "stats:clear": "node run-script.js clear-stats",
    "test": "npm run test:ts && npm run test:unit && npm run test:e2e",
    "test:e2e": "MERCURE_JWT_KEY=test_mercure_jwt_key DEFINER_APP_TYPE=mock TRANSLATOR_APP_TYPE=mock LLM_PROVIDER=mock LLM_MODEL=mock IMAGE_GENERATOR_API_URL=http://localhost:3000 IMAGE_GENERATOR_PROVIDER=mock vitest run -c vitest.e2e.config.ts",
    "test:ts": "tsc --noEmit",
    "test:unit": "MERCURE_JWT_KEY=test_mercure_jwt_key DEFINER_APP_TYPE=mock TRANSLATOR_APP_TYPE=mock LLM_PROVIDER=mock LLM_MODEL=mock IMAGE_GENERATOR_API_URL=http://localhost:3000 IMAGE_GENERATOR_PROVIDER=mock vitest run --fileParallelism false",
    "users:create-admin": "node run-script.js manage-users create-admin",
    "users:list": "node run-script.js manage-users list",
    "users:make-admin": "node run-script.js manage-users make-admin",
    "users:make-regular": "node run-script.js manage-users make-regular",
    "users:revoke-admin": "node run-script.js manage-users make-regular",
    "image:cli": "node run-script.js test-definition-images",
    "test:cli:image": "node run-script.js test-definition-images"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vitest-mock-extended": "^5.1.1"
  }
}
