# Port mapping for base service
PORT=3001
# PostgreSQL connection string
DATABASE_URL="postgresql://dkoldaev@localhost:5432/english_card_bot?schema=public"
# JWT Secret for authentication
JWT_SECRET="supersecret_docker_key"
# Internal Mercure URL for pushing events
MERCURE_URL="http://localhost:9090/.well-known/mercure"
# JWT Secret for Mercure authentication
MERCURE_JWT="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJtZXJjdXJlIjp7InB1Ymxpc2giOlsiKiJdLCJzdWJzY3JpYmUiOlsiKiJdfX0.5BjhyMyl5WfulsFBQtWtb49ppcWnv_6ZEkwn5SxycNA"
# Internal URL of Translator service
TRANSLATOR_API_URL="http://localhost:3002/api/v1/translate"
# Internal URL of Definer service
DEFINER_API_URL="http://localhost:3003/api/v1/define"
# Definer app type to use (mock, mistral, gemini, freedictionary)
DEFINER_APP_TYPE="freedictionary"
# Translator app type to use (mock, googletranslate, laratranslate, llm, mistral, gemini)
TRANSLATOR_APP_TYPE="laratranslate"
# Base domain of the application
BASE_DOMAIN="http://localhost"
# Redis connection URL
REDIS_URL="redis://localhost:6379"
# Allowed CORS origin (usually frontend)
CORS_ORIGIN="http://localhost:5173"
# Internal URL of LLM service
LLM_API_URL="http://localhost:3003/api/v1/generate"
# LLM Provider to use (mock, mistral, gemini)
LLM_PROVIDER="mock"
# LLM Model to use
LLM_MODEL="mock"
# Enable test username authentication (for testing/development)
ENABLE_TEST_AUTH="true"
# Guest mode AI generation setting (true/false) and daily limit per IP
ALLOW_GUEST_AI_GENERATION="false"
GUEST_AI_DAILY_LIMIT="10"
ENABLE_DB_LOGGING="false"

IMAGE_GENERATOR_API_URL="http://localhost:3004/api/v1/images"
IMAGE_GENERATOR_PROVIDER="mock"
