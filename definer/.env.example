# Port on which the definer app runs
PORT=3002
# Definer app type to use (mock, freedictionary, mistral, gemini, llm)
DEFINER_APP_TYPE=mock
# URL of the LLM service
LLM_SERVICE_URL=http://llm:3003/api/v1/generate
# LLM Provider for definer (mistral, gemini, mock)
LLM_PROVIDER=mistral
# LLM Model for definer
LLM_MODEL=open-mistral-nemo
# Mock timeout (ms)
LLM_MOCK_TIMEOUT=0
CACHE_URL=redis://redis:6379/2
TRANSLATOR_API_URL=http://translator:3001/api/v1/translate
TRANSLATOR_APP_TYPE=mock

