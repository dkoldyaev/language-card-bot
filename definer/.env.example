# Port on which the definer app runs
PORT=3002
# Definer app type to use (mock, freedictionary, mistral, gemini, llm)
DEFINER_APP_TYPE=mock
# URL of the LLM service
LLM_SERVICE_URL=http://llm:3003/api/v1/generate
# Mock timeout (ms)
MOCK_TIMEOUT=0
# Redis URL for caching definitions
CACHE_URL=redis://redis:6379/2
