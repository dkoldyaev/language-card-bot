{
  "name": "english-card-bot-2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:profile": "npm run --prefix base db:profile",
    "definer:cli": "npm run --prefix definer test:cli --",
    "docker:down": "docker compose down",
    "docker:frontend:install": "docker compose exec frontend npm install",
    "docker:logs:app": "docker compose logs app",
    "docker:logs:frontend": "docker compose logs --tail=20 frontend",
    "docker:logs:redis": "docker compose logs redis",
    "docker:ps": "docker compose ps",
    "docker:restart:frontend": "docker compose restart frontend",
    "docker:stats:clear": "docker compose exec app npm run stats:clear",
    "docker:up": "docker compose up --build",
    "docker:up:d": "docker compose up --build -d",
    "dokploy:configure-dev": "npx --prefix base tsx scripts/configure-dokploy-dev.ts",
    "dokploy:deploy": "node scripts/create-dokploy-env.mjs",
    "dokploy:destroy": "node scripts/destroy-dokploy-env.mjs",
    "lint": "biome check .",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write .",
    "llm:cli": "npm run --prefix llm test:cli --",
    "preset:create": "npm run --prefix base preset:create --",
    "preset:list": "npm run --prefix base preset:list --",
    "preset:remove": "npm run --prefix base preset:remove --",
    "read:dokploy:logs": "node scripts/read-dokploy-logs.mjs",
    "stats:clear": "npm run --prefix base stats:clear",
    "test": "npm run test:ts && npm run test:unit && npm run test:e2e",
    "test:base": "npm run --prefix base test",
    "test:cli:definer": "npm run --prefix definer test:cli --",
    "test:cli:llm": "npm run --prefix llm test:cli --",
    "test:cli:translator": "npm run --prefix translator test:cli --",
    "test:definer": "npm run --prefix definer test",
    "test:e2e": "npm run --prefix base test:e2e && npm run --prefix frontend test:e2e",
    "test:frontend": "npm run --prefix frontend test",
    "test:frontend:build": "npm run --prefix frontend build",
    "test:frontend:e2e": "npm run --prefix frontend test:e2e",
    "test:frontend:unit": "npm run --prefix frontend test:unit",
    "test:llm": "npm run --prefix llm test",
    "test:translator": "npm run --prefix translator test",
    "test:ts": "npm run --prefix base test:ts && npm run --prefix definer test:ts && npm run --prefix translator test:ts && npm run --prefix llm test:ts && npm run --prefix frontend test:ts",
    "test:unit": "npm run --prefix base test:unit && npm run --prefix definer test && npm run --prefix translator test && npm run --prefix llm test && npm run --prefix frontend test:unit",
    "translator:cli": "npm run --prefix translator test:cli --",
    "users:create-admin": "npm run --prefix base users:create-admin --",
    "users:list": "npm run --prefix base users:list --",
    "users:make-admin": "npm run --prefix base users:make-admin --",
    "users:make-regular": "npm run --prefix base users:make-regular --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13"
  }
}
