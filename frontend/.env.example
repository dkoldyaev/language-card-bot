# Public API URL for frontend to connect to base service
VITE_API_BASE_URL=http://localhost:3001/api/v1
# Public Mercure URL for frontend to connect to events
VITE_MERCURE_PUBLIC_URL=http://localhost:9090/.well-known/mercure
# Base domain used in frontend
VITE_BASE_DOMAIN=http://localhost
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
# Auth provider to use: google | test-username
VITE_AUTH_PROVIDER=google
# Base URL for Playwright E2E tests
PLAYWRIGHT_TEST_BASE_URL=http://localhost:5173
