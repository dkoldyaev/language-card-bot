FROM node:20-alpine AS dev
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG PORT=5173
ENV PORT=${PORT}
ARG AUTH_PROVIDER
ENV AUTH_PROVIDER=${AUTH_PROVIDER}
ENV VITE_AUTH_PROVIDER=${AUTH_PROVIDER}
ARG API_BASE_URL
ENV VITE_API_BASE_URL=${API_BASE_URL}
ARG MERCURE_PUBLIC_URL
ENV VITE_MERCURE_PUBLIC_URL=${MERCURE_PUBLIC_URL}
ARG BASE_DOMAIN
ENV VITE_BASE_DOMAIN=${BASE_DOMAIN}
EXPOSE ${PORT}
CMD ["sh", "-c", "export VITE_AUTH_PROVIDER=\"${AUTH_PROVIDER:-$VITE_AUTH_PROVIDER}\" && export VITE_API_BASE_URL=\"${API_BASE_URL:-$VITE_API_BASE_URL}\" && export VITE_MERCURE_PUBLIC_URL=\"${MERCURE_PUBLIC_URL:-$VITE_MERCURE_PUBLIC_URL}\" && export VITE_BASE_DOMAIN=\"${BASE_DOMAIN:-$VITE_BASE_DOMAIN}\" && npx vite --host 0.0.0.0 --port ${PORT}"]

FROM dev AS development

FROM node:20-alpine AS production
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG API_BASE_URL
ENV VITE_API_BASE_URL=${API_BASE_URL}
ARG MERCURE_PUBLIC_URL
ENV VITE_MERCURE_PUBLIC_URL=${MERCURE_PUBLIC_URL}
ARG BASE_DOMAIN
ENV VITE_BASE_DOMAIN=${BASE_DOMAIN}
ARG GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
ARG ALLOWED_HOSTS
ENV VITE_ALLOWED_HOSTS=${ALLOWED_HOSTS}
ARG AUTH_PROVIDER
ENV VITE_AUTH_PROVIDER=${AUTH_PROVIDER}
RUN npm run build
ARG PORT=5173
ENV PORT=${PORT}
EXPOSE ${PORT}
# You can use serve or nginx here. For now, vite preview
CMD ["sh", "-c", "npx vite preview --host 0.0.0.0 --port ${PORT}"]
