# Port on which the translator app runs
PORT=3001
# Google Translate API Key (leave empty if only using "mock" adapter)
GOOGLE_TRANSLATE_API_KEY=
# Mock timeout (ms, 0 for no delay)
MOCK_TIMEOUT=0
# Lara API Keys
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=
# Redis URL for caching translations
CACHE_URL=redis://localhost:6379/1
# URL of the LLM service
LLM_SERVICE_URL=http://localhost:3003/api/v1/generate
# LLM provider (mock, mistral, gemini)
TRANSLATOR_LLM_PROVIDER=mistral
# LLM model
TRANSLATOR_LLM_MODEL=open-mistral-nemo
