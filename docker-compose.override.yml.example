# Example local override for Docker Compose
# Copy this file to docker-compose.override.yml:
#   cp docker-compose.override.yml.example docker-compose.override.yml

version: '3.8'

services:
  # Traefik reverse proxy routing all HTTP traffic through port 5174
  traefik-app:
    image: traefik:v3.1
    command:
      - "--api.insecure=true"
      - "--api.dashboard=true"
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:5174"
      - "--entrypoints.traefik.address=:8080"
      - "--entrypoints.db.address=:5434"
      - "--entrypoints.redis.address=:6380"
    ports:
      # Unified entrypoint for frontend, backend API, and Mercure
      - "${TRAEFIK_PORT:-5174}:5174"
      # Traefik dashboard (http://localhost:8080/dashboard/)
      - "8080:8080"
      # Database and Redis TCP proxies
      - "5434:5434"
      - "6380:6380"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro

  frontend:
    labels:
      - "traefik.enable=true"
      # Root and SPA routing -> frontend:5173
      - "traefik.http.routers.frontend.rule=PathPrefix(`/`)"
      - "traefik.http.routers.frontend.entrypoints=web"
      - "traefik.http.routers.frontend.priority=1"
      - "traefik.http.services.frontend.loadbalancer.server.port=5173"

  app:
    labels:
      - "traefik.enable=true"
      # API routing -> app:3001
      - "traefik.http.routers.app.rule=PathPrefix(`/api`)"
      - "traefik.http.routers.app.entrypoints=web"
      - "traefik.http.routers.app.priority=10"
      - "traefik.http.services.app.loadbalancer.server.port=${BASE_PORT:-3001}"

  mercure:
    labels:
      - "traefik.enable=true"
      # Mercure Hub SSE routing -> mercure:80
      - "traefik.http.routers.mercure.rule=PathPrefix(`/.well-known/mercure`)"
      - "traefik.http.routers.mercure.entrypoints=web"
      - "traefik.http.routers.mercure.priority=20"
      - "traefik.http.services.mercure.loadbalancer.server.port=80"

  db_test:
    image: postgres:15-alpine
    labels:
      - "traefik.enable=true"
      - "traefik.tcp.routers.db.rule=HostSNI(`*`)"
      - "traefik.tcp.routers.db.entrypoints=db"
      - "traefik.tcp.services.db.loadbalancer.server.port=5432"

  redis_test:
    image: redis:7-alpine
    labels:
      - "traefik.enable=true"
      - "traefik.tcp.routers.redis-test.rule=HostSNI(`*`)"
      - "traefik.tcp.routers.redis-test.entrypoints=redis"
      - "traefik.tcp.services.redis-test.loadbalancer.server.port=6379"

  redis:
    image: redis:7-alpine
    labels:
      - "traefik.enable=true"
      - "traefik.tcp.routers.redis-prod.rule=HostSNI(`*`)"
      - "traefik.tcp.routers.redis-prod.entrypoints=redis"
      - "traefik.tcp.services.redis-prod.loadbalancer.server.port=6379"
