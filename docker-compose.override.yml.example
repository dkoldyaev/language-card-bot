# Example local override for Docker Compose
# Copy this file to docker-compose.override.yml:
#   cp docker-compose.override.yml.example docker-compose.override.yml

version: '3.8'

services:
  traefik-app:
    image: traefik:v3.1
    command:
      - "--api.insecure=true"
      - "--api.dashboard=true"
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:5174"
      - "--entrypoints.traefik.address=:8080"
    ports:
      # Unified entrypoint for frontend, backend API, and Mercure
      - "${TRAEFIK_PORT}:5174"
      # Traefik dashboard
      - "8080:8080"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro

  frontend:
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.frontend.rule=PathPrefix(`/`)"
      - "traefik.http.routers.frontend.entrypoints=web"
      - "traefik.http.routers.frontend.priority=1"
      - "traefik.http.services.frontend.loadbalancer.server.port=5173"
    volumes:
      - ./frontend:/app
      - /app/node_modules
      - /app/dist

  app:
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.app.rule=PathPrefix(`/api`)"
      - "traefik.http.routers.app.entrypoints=web"
      - "traefik.http.routers.app.priority=10"
      - "traefik.http.services.app.loadbalancer.server.port=${BASE_PORT}"
    environment:
      - REDIS_URL=redis://redis:6379
    depends_on:
      - redis
    volumes:
      - ./base:/app
      - /app/node_modules
      - /app/dist

  mercure:
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.mercure.rule=PathPrefix(`/.well-known/mercure`)"
      - "traefik.http.routers.mercure.entrypoints=web"
      - "traefik.http.routers.mercure.priority=20"
      - "traefik.http.services.mercure.loadbalancer.server.port=80"
    ports:
      - "9090:80"

  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data

  translator:
    environment:
      - CACHE_URL=redis://redis:6379/1
    depends_on:
      - redis
    volumes:
      - ./translator:/app
      - /app/node_modules
      - /app/dist

  definer:
    environment:
      - CACHE_URL=redis://redis:6379/2
    depends_on:
      - redis
    volumes:
      - ./definer:/app
      - /app/node_modules
      - /app/dist

  llm:
    environment:
      - CACHE_URL=redis://redis:6379/3
    depends_on:
      - redis
    volumes:
      - ./llm:/app
      - /app/node_modules
      - /app/dist


  image-generator:
    environment:
      - CACHE_URL=redis://redis:6379/5
    depends_on:
      - redis
    volumes:
      - ./image-generator:/app
      - /app/node_modules
      - /app/dist

volumes:
  redis_data:
